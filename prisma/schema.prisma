generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Developer {
  id                 String             @id @default(cuid())
  githubHandle       String             @unique
  githubId           String             @unique
  name               String?
  avatarUrl          String?
  bio                String?
  company            String?
  location           String?
  country            String?
  city               String?
  continent          String?
  website            String?
  twitterHandle      String?
  totalCommits       Int                @default(0)
  totalPullRequests  Int                @default(0)
  totalIssues        Int                @default(0)
  totalStars         Int                @default(0)
  totalReviews       Int                @default(0)
  totalRepos         Int                @default(0)
  followers          Int                @default(0)
  following          Int                @default(0)
  score              Float              @default(0)
  activityData       Json?
  lastFetched        DateTime           @updatedAt
  createdAt          DateTime           @default(now())
  leaderboardEntries LeaderboardEntry[]
  repositories       Repository[]

  @@map("developers")
}

model LeaderboardEntry {
  id           String    @id @default(cuid())
  scope        String
  location     String?
  timeframe    String
  metric       String
  rank         Int
  score        Float
  snapshotDate DateTime  @default(now())
  developerId  String
  developer    Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@unique([developerId, scope, location, timeframe, metric, snapshotDate])
  @@map("leaderboard_entries")
}

model Repository {
  id              String        @id @default(cuid())
  githubId        String        @unique
  name            String
  fullName        String
  private         Boolean       @default(false)
  description     String?
  htmlUrl         String
  cloneUrl        String
  sshUrl          String
  language        String?
  stargazersCount Int           @default(0)
  forksCount      Int           @default(0)
  size            Int           @default(0)
  openIssuesCount Int           @default(0)
  watchersCount   Int           @default(0)
  defaultBranch   String        @default("main")
  createdAt       DateTime
  updatedAt       DateTime
  pushedAt        DateTime?
  userId          String?
  developerId     String?
  commits         Commit[]
  issues          Issue[]
  pullRequests    PullRequest[]
  developer       Developer?    @relation(fields: [developerId], references: [id], onDelete: Cascade)
  user            User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("repositories")
}

model Commit {
  id             String     @id @default(cuid())
  sha            String     @unique
  message        String
  authorName     String
  authorEmail    String
  authorDate     DateTime
  committerName  String
  committerEmail String
  committerDate  DateTime
  additions      Int        @default(0)
  deletions      Int        @default(0)
  changedFiles   Int        @default(0)
  repositoryId   String
  createdAt      DateTime   @default(now())
  repository     Repository @relation(fields: [repositoryId], references: [id])

  @@index([repositoryId])
  @@index([authorDate])
  @@map("commits")
}

model PullRequest {
  id            String     @id @default(cuid())
  githubId      String     @unique
  number        Int
  title         String
  state         String
  watchersCount Int        @default(0)
  body          String?
  createdAt     DateTime
  updatedAt     DateTime
  closedAt      DateTime?
  mergedAt      DateTime?
  additions     Int        @default(0)
  deletions     Int        @default(0)
  changedFiles  Int        @default(0)
  repositoryId  String
  repository    Repository @relation(fields: [repositoryId], references: [id])

  @@index([repositoryId])
  @@map("pull_requests")
}

model Issue {
  id           String     @id @default(cuid())
  githubId     String     @unique
  number       Int
  title        String
  state        String
  body         String?
  createdAt    DateTime
  updatedAt    DateTime
  closedAt     DateTime?
  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id])

  @@index([repositoryId])
  @@map("issues")
}

model CommitStat {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  commitCount  Int      @default(0)
  additions    Int      @default(0)
  deletions    Int      @default(0)
  changedFiles Int      @default(0)
  userId       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("commit_stats")
}

model LanguageStat {
  id         String   @id @default(cuid())
  language   String
  percentage Float
  bytes      Int      @default(0)
  userId     String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, language])
  @@index([userId])
  @@map("language_stats")
}

model ContributionStat {
  id                String   @id @default(cuid())
  date              DateTime @db.Date
  contributionCount Int      @default(0)
  userId            String
  createdAt         DateTime @default(now())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, date])
  @@map("contribution_stats")
}

model User {
  id                String             @id @default(cuid())
  name              String?
  email             String             @unique
  emailVerified     DateTime?
  image             String?
  bio               String?
  location          String?
  website           String?
  company           String?
  blog              String?
  twitterUsername   String?
  githubUsername    String?
  publicRepos       Int?
  followers         Int?
  following         Int?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  githubAccessToken String?
  tokenExpiresAt    DateTime?
  lastSyncedAt      DateTime?
  accounts          Account[]
  commitStats       CommitStat[]
  contributionStats ContributionStat[]
  languageStats     LanguageStat[]
  repositories      Repository[]
  sessions          Session[]

  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}
